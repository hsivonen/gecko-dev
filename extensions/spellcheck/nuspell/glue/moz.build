UNIFIED_SOURCES += [
    'mozNuspell.cpp',
    'mozNuspellFileMgr.cpp',
    'RemoteSpellCheckEngineChild.cpp',
    'RemoteSpellCheckEngineParent.cpp',
]

DEFINES['NUSPELL_STATIC'] = True

FINAL_LIBRARY = 'xul'

LOCAL_INCLUDES += [
    '../src',
    '/dom/base',
    '/extensions/spellcheck/src',
]

include('/ipc/chromium/chromium-config.mozbuild')
include('common.mozbuild')

NuspellIncludes()

IPDL_SOURCES = [
    'PRemoteSpellcheckEngine.ipdl',
]

EXPORTS.mozilla += [
     'RemoteSpellCheckEngineChild.h',
     'RemoteSpellCheckEngineParent.h',
]

if CONFIG['CC_TYPE'] in ('clang', 'clang-cl'):
    CXXFLAGS += [
        # We force-include mozNuspellAllocator.h from third-party code.
        '-Wno-undefined-var-template',
    ]
